1. read one df fom jdbc
2.second df from a file
3.join using column1 
4.save it to a jdbc table


spark=SparkSession.builder.appName("Jbc_join").getOrCreate()

#1.jdbc connection

df=spark.read.format("jdbc").option("url", "url").option("username","user").option("password","password").option(database_table","employee").load()

#read first df file

df1=spark.read.csv("/path/data1.csv")

#join using user_id

final_df=df.join(df1,"user_id","inner").agg(sum("employee_name"))

#jdbc table output

final_df.write.format("jdbc").option("url", "url").option("username","user").option("password","password").option(database_table","employe_output").mode("overwrite"
.save()


