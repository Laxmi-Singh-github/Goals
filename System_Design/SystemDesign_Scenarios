select bs.product_id,sum(bs.quantity) as qauntity
from bill_info bi
join bill_sales bs
on bi.bill_id=bs.bill_id
where bi.date between '2026-01-01' and '2026-06-03'
group by bs.product_id
order by quantity desc
limit 1


